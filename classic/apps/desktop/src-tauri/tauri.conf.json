{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "HovaCut",
	"version": "0.1.0",
	"identifier": "vn.hova.hovacut",
	"build": {
		"beforeDevCommand": "powershell -ExecutionPolicy Bypass -File ../prepare-frontend.ps1",
		"beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ../prepare-frontend.ps1",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "HovaCut Desktop",
				"url": "automation/index.html",
				"width": 1440,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700,
				"maximized": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": { "enable": true, "scope": ["**"] }
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["../../web/public/favicon.ico"]
	}
}
